#!/bin/bash

# =========================================================
# PBS JOB CONFIGURATION
# =========================================================

#PBS -N NYS_PySAM_Optimization_2Nodes
#PBS -q medium
#PBS -l select=2:ncpus=112:mpiprocs=1
#PBS -l place=scatter
#PBS -j oe
#PBS -M 23b0343@iitb.ac.in
#PBS -m abe


# =========================================================
# MOVE TO PROJECT DIRECTORY
# =========================================================

cd "$PBS_O_WORKDIR" || exit 1

echo "================================================="
echo "NYS PySAM Seasonal Optimisation - 2 Nodes"
echo "================================================="
echo "Job ID       : $PBS_JOBID"
echo "Job Name     : $PBS_JOBNAME"
echo "Working Dir  : $PBS_O_WORKDIR"
echo "Node File    : $PBS_NODEFILE"
echo "Total CPUs   : $PBS_NCPUS"
echo "Season       : $SEASON"
echo "================================================="


# =========================================================
# CHECK SEASON
# =========================================================

if [ -z "$SEASON" ]; then
    echo "ERROR: SEASON was not specified."
    echo "Submit using:"
    echo "    qsub -v SEASON=winter season_2nodes.pbs"
    exit 1
fi

case "$SEASON" in
    winter|summer|monsoon|post)
        ;;
    *)
        echo "ERROR: Invalid season: $SEASON"
        echo "Allowed: winter, summer, monsoon, post"
        exit 1
        ;;
esac


# =========================================================
# DAGSHUB / MLFLOW AUTHENTICATION
# =========================================================

if [ -f "$HOME/.dagshub_token" ]; then

    export MLFLOW_TRACKING_USERNAME="aryanvj787"

    export MLFLOW_TRACKING_PASSWORD="$(
        cat "$HOME/.dagshub_token"
    )"

    export MLFLOW_TRACKING_URI="https://dagshub.com/aryanvj787/NYS-Design-Optimisation-using-PySAM.mlflow"

    echo "MLflow/DagsHub authentication configured."

else

    echo "WARNING: $HOME/.dagshub_token not found."
    echo "MLflow logging may fail."

fi


# =========================================================
# PYTHON ENVIRONMENT
# =========================================================

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
else
    echo "ERROR: .venv not found."
    exit 1
fi


# =========================================================
# PARALLELISM CONTROL
# =========================================================

export APP_CPU_COUNT="$PBS_NCPUS"

# One multiprocessing pool per MPI rank.
export LOCAL_WORKERS=112

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


# =========================================================
# DISPLAY ALLOCATION
# =========================================================

echo ""
echo "Allocated nodes:"
sort -u "$PBS_NODEFILE"

echo ""
echo "MPI ranks: 2"
echo "CPUs per MPI rank: 112"
echo "Total CPUs: $APP_CPU_COUNT"
echo "Local workers per rank: $LOCAL_WORKERS"
echo "Season: $SEASON"

echo ""
echo "================================================="
echo "Starting MPI optimisation..."
echo "================================================="


# =========================================================
# RUN
# =========================================================

mpirun -np 2 \
    uv run python main.py \
    --season "$SEASON"

EXIT_CODE=$?


# =========================================================
# FINISH
# =========================================================

echo ""
echo "================================================="
echo "Optimisation finished"
echo "Exit code: $EXIT_CODE"
echo "Season: $SEASON"
echo "================================================="

exit "$EXIT_CODE"