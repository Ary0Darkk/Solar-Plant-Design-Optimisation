{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Fast Demo Run (Summer, 4 Pop, 2 Gens)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deap_ga_optimiser.py",
      "args": ["--season", "summer", "--pop-size", "4", "--generations", "2"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Full GA Run (Winter, 28 Pop, 10 Gens)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deap_ga_optimiser.py",
      "args": ["--season", "winter", "--pop-size", "28", "--generations", "10"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
