#!/bin/bash
#PBS -N CSP_GA_Opt
#PBS -l select=4:ncpus=112:mpiprocs=1
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -q standard
#PBS -j oe
#PBS -o logs/pbs_${PBS_JOBID}.log

# ==============================================================================
# Multi-Node HPC Hybrid MPI + Multiprocessing PBS Script
# ==============================================================================

cd "$PBS_O_WORKDIR" || exit 1
mkdir -p logs results/GA_results plots/GA_plots

# Load system Python/MPI environment (customize for cluster)
# module load python/3.12 openmpi/4.1

# Activate virtual environment
if [ -d ".venv" ]; then
    source .venv/bin/activate
fi

# Load environment secrets if .env exists
if [ -f ".env" ]; then
    set -a
    source .env
    set +a
fi

SEASON=${SEASON:-summer}
export LOCAL_WORKERS=${LOCAL_WORKERS:-112}

echo "=========================================================="
echo "Job ID:    $PBS_JOBID"
echo "Nodes:     $(wc -l < "$PBS_NODEFILE")"
echo "Workers:   $LOCAL_WORKERS per node"
echo "Season:    $SEASON"
echo "Start:     $(date)"
echo "=========================================================="

mpirun python main.py --season "$SEASON"

echo "Job finished at: $(date)"
