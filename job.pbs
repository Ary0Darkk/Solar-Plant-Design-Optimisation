#!/bin/bash
# ==============================================================================
# Concentrated Solar Power (CSP) Genetic Algorithm Optimization
# Unified PBS Batch Script for HPC Clusters (e.g. C-DAC Pratyush, Param)
# ==============================================================================
#PBS -N CSP_GA_Opt
#PBS -l select=1:ncpus=112:mpiprocs=1
#PBS -l walltime=24:00:00
#PBS -q standard
#PBS -j oe
#PBS -V

set -e

# Change to the submission directory
cd "$PBS_O_WORKDIR"

echo "=========================================================="
echo "Job ID: $PBS_JOBID"
echo "Running on Host: $(hostname)"
echo "Started at: $(date)"
echo "Cores Allocated: $PBS_NCPUS"
echo "=========================================================="

# Activate virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
elif [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
fi

# Target season: override via `qsub -v SEASON=winter job.pbs` (default: summer)
SEASON="${SEASON:-summer}"
GENERATIONS="${GENERATIONS:-100}"
POP_SIZE="${POP_SIZE:-112}"
WORKERS="${WORKERS:-112}"

echo "Optimizing Season: $SEASON"
echo "Pop Size: $POP_SIZE | Generations: $GENERATIONS | Workers: $WORKERS"
echo "=========================================================="

if [ "$SEASON" = "all" ]; then
    for s in winter summer monsoon post; do
        echo ">>> Commencing Optimization for Season: $s <<<"
        python main.py --season "$s" --pop-size "$POP_SIZE" --generations "$GENERATIONS" --workers "$WORKERS"
    done
else
    python main.py --season "$SEASON" --pop-size "$POP_SIZE" --generations "$GENERATIONS" --workers "$WORKERS"
fi

echo "=========================================================="
echo "Job finished at: $(date)"
echo "=========================================================="
