#!/bin/bash

# =========================================================
# PBS JOB CONFIGURATION - MPI MULTI-NODE PRE-FLIGHT TEST
# =========================================================

#PBS -N NYS_MPI_Check
#PBS -q standard
#PBS -l select=2:ncpus=16
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m abe

# Ensure standard user paths
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

cd "$PBS_O_WORKDIR" || exit 1

echo "================================================="
echo "  NYS PySAM MPI Cluster Diagnostic Job"
echo "================================================="
echo "Job ID       : $PBS_JOBID"
echo "Node File    : $PBS_NODEFILE"
echo "Allocated Nodes:"
sort -u "$PBS_NODEFILE"
echo "================================================="

# Activate virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
elif [ -f "$PBS_O_WORKDIR/.venv/bin/activate" ]; then
    source "$PBS_O_WORKDIR/.venv/bin/activate"
else
    echo "ERROR: .venv/bin/activate not found. Run 'uv sync' or 'python3 -m venv .venv'."
    exit 1
fi

# Ensure mpirun exists
if ! command -v mpirun >/dev/null 2>&1; then
    echo "ERROR: mpirun command not found in PATH."
    echo "You may need to load an MPI module, for example:"
    echo "  module load openmpi"
    echo "  module load intel-mpi"
    exit 1
fi

echo "MPI Launcher: $(which mpirun)"
echo "Python Exec : $(which python)"
echo ""

# Launch 2 MPI ranks across the 2 allocated nodes
mpirun -np 2 \
    --hostfile "$PBS_NODEFILE" \
    python test_hpc_mpi.py

EXIT_CODE=$?

echo ""
echo "================================================="
echo "MPI Pre-flight check finished with exit code: $EXIT_CODE"
echo "================================================="

exit "$EXIT_CODE"
