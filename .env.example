# Number of parallel multiprocessing workers per MPI rank
# (HPC default: 112; automatically scales to 4 on local workstations)
LOCAL_WORKERS=4

# Interactive matplotlib display (1 = enable, 0 = disable)
SHOW_PLOTS=0

# ---------------------------------------------------------
# Remote DagsHub / MLflow Experiment Tracking
# ---------------------------------------------------------
DAGSHUB_USER_NAME=aryanvj787
DAGSHUB_REPO_NAME=NYS-Design-Optimisation-using-PySAM
DAGSHUB_USER_TOKEN=your_dagshub_token_here
MLFLOW_TRACKING_USERNAME=aryanvj787
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here
