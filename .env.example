# =========================================================
# Solar Plant Design & Optimization - Environment Variables
# =========================================================

# Number of parallel multiprocessing workers per MPI rank
# (HPC default: 112; automatically falls back to 4 on local workstations)
LOCAL_WORKERS=112

# Interactive matplotlib display (1 = enable, 0 = disable)
SHOW_PLOTS=0

# ---------------------------------------------------------
# Remote DagsHub / MLflow Experiment Tracking
# ---------------------------------------------------------
DAGSHUB_USER_NAME=aryanvj787
DAGSHUB_REPO_NAME=NYS-Design-Optimisation-using-PySAM
DAGSHUB_USER_TOKEN=
MLFLOW_TRACKING_USERNAME=aryanvj787
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_URI=https://dagshub.com/aryanvj787/NYS-Design-Optimisation-using-PySAM.mlflow

