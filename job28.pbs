#!/bin/bash

#PBS -N NYS_All_Seasons
#PBS -q large
#PBS -l select=28:ncpus=112:mpiprocs=1
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M 23b0343@iitb.ac.in
#PBS -m abe

set -u

cd "$PBS_O_WORKDIR" || exit 1

echo "Job ID: $PBS_JOBID"
echo "Working directory: $PBS_O_WORKDIR"
echo "Total CPUs: $PBS_NCPUS"

# ---------------------------------------------------------
# Python environment
# ---------------------------------------------------------

if [ ! -f ".venv/bin/activate" ]; then
    echo "ERROR: .venv not found."
    exit 1
fi

source .venv/bin/activate

# ---------------------------------------------------------
# DagsHub / MLflow authentication
# ---------------------------------------------------------

if [ -f "$HOME/.dagshub_token" ]; then
    export MLFLOW_TRACKING_USERNAME="aryanvj787"
    export MLFLOW_TRACKING_PASSWORD="$(cat "$HOME/.dagshub_token")"
    export MLFLOW_TRACKING_URI="https://dagshub.com/aryanvj787/NYS-Design-Optimisation-using-PySAM.mlflow"
else
    echo "WARNING: DagsHub token not found."
fi

# ---------------------------------------------------------
# Parallelism settings
# ---------------------------------------------------------

export LOCAL_WORKERS=112
export APP_CPU_COUNT="$PBS_NCPUS"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# ---------------------------------------------------------
# Split the 28 allocated hosts into four groups
# ---------------------------------------------------------

WORK_DIR="${TMPDIR:-/tmp}/nys_${PBS_JOBID//[^a-zA-Z0-9]/_}"
mkdir -p "$WORK_DIR"

sort -u "$PBS_NODEFILE" > "$WORK_DIR/all_hosts.txt"

HOST_COUNT=$(wc -l < "$WORK_DIR/all_hosts.txt")

if [ "$HOST_COUNT" -ne 28 ]; then
    echo "ERROR: Expected 28 unique hosts, found $HOST_COUNT."
    echo "Allocated hosts:"
    cat "$WORK_DIR/all_hosts.txt"
    exit 1
fi

sed -n '1,7p'   "$WORK_DIR/all_hosts.txt" > "$WORK_DIR/winter.hosts"
sed -n '8,14p'  "$WORK_DIR/all_hosts.txt" > "$WORK_DIR/summer.hosts"
sed -n '15,21p' "$WORK_DIR/all_hosts.txt" > "$WORK_DIR/monsoon.hosts"
sed -n '22,28p' "$WORK_DIR/all_hosts.txt" > "$WORK_DIR/post.hosts"

echo "Host allocation:"
for season in winter summer monsoon post; do
    echo "---- $season ----"
    cat "$WORK_DIR/$season.hosts"
done

# ---------------------------------------------------------
# Launch four independent MPI runs
# ---------------------------------------------------------

# IMPORTANT:
# Confirm that your cluster's MPI implementation supports
# hostfile-restricted launches inside PBS before production use.

mpirun -hostfile "$WORK_DIR/winter.hosts" -np 7 \
    uv run python main.py --season winter \
    > "$WORK_DIR/winter.log" 2>&1 &
PID_WINTER=$!

mpirun -hostfile "$WORK_DIR/summer.hosts" -np 7 \
    uv run python main.py --season summer \
    > "$WORK_DIR/summer.log" 2>&1 &
PID_SUMMER=$!

mpirun -hostfile "$WORK_DIR/monsoon.hosts" -np 7 \
    uv run python main.py --season monsoon \
    > "$WORK_DIR/monsoon.log" 2>&1 &
PID_MONSOON=$!

mpirun -hostfile "$WORK_DIR/post.hosts" -np 7 \
    uv run python main.py --season post \
    > "$WORK_DIR/post.log" 2>&1 &
PID_POST=$!

# ---------------------------------------------------------
# Wait for all four runs and collect exit codes
# ---------------------------------------------------------

wait "$PID_WINTER"
STATUS_WINTER=$?

wait "$PID_SUMMER"
STATUS_SUMMER=$?

wait "$PID_MONSOON"
STATUS_MONSOON=$?

wait "$PID_POST"
STATUS_POST=$?

echo "================================================="
echo "Season results"
echo "winter : $STATUS_WINTER"
echo "summer : $STATUS_SUMMER"
echo "monsoon: $STATUS_MONSOON"
echo "post   : $STATUS_POST"
echo "Logs   : $WORK_DIR"
echo "================================================="

if [ "$STATUS_WINTER" -ne 0 ] ||
   [ "$STATUS_SUMMER" -ne 0 ] ||
   [ "$STATUS_MONSOON" -ne 0 ] ||
   [ "$STATUS_POST" -ne 0 ]; then
    exit 1
fi

exit 0